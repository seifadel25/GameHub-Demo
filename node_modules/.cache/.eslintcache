ppressedMessages":"159","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"160","messages":"161","suppressedMessages":"162","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"163","messages":"164","suppressedMessages":"165","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\index.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\App.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\pages\\AllMeetups.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\pages\\NewMeetup.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\pages\\Favs.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\layout\\MainNav.js",["166"],[],"import { Link } from \"react-router-dom\";\r\nimport { useContext } from \"react\";\r\nimport FavContext from \"../../store/fav-context\";\r\n//import ThemeSwitcher from \"../UI/ThemeSwitcher\";\r\nimport { useState } from \"react\";\r\nimport classNames from \"classnames\";\r\n\r\nlet Links = [\r\n  {\r\n    name: \"All Meets\",\r\n    path: \"/\",\r\n  },\r\n  {\r\n    name: \"New Meets\",\r\n    path: \"/new-meetup\",\r\n  },\r\n  {\r\n    name: \"Favourites\",\r\n    path: \"/favs\",\r\n  },\r\n];\r\n\r\nfunction MainNav(props) {\r\n  const FavCtx = useContext(FavContext);\r\n  let [open, setOpen] = useState(false);\r\n  const classname = classNames(\r\n    \"flex\",\r\n    \"md:flex-row\",\r\n    \"flex-col\",\r\n    \"ml-1\",\r\n    \"items-center\",\r\n    \"md:pb-0\",\r\n    \"pb-0\",\r\n    \"pt-8\",\r\n    \"md:pt-0\",\r\n    \"md:static\",\r\n    \"bg-white\",\r\n    \"md:z-auto\",\r\n    \"z-8\",\r\n    \"min-h-full\",\r\n    \"left-0\",\r\n    \"w-full\",\r\n    \"md:w-auto\",\r\n    \"md:pl-0\",\r\n    \"pl-0\",\r\n\r\n    \"dark:bg-slate-950\",\r\n    `${\r\n      open\r\n        ? \"static visible  md:visible md:animate-none animate-fade-in pb-0 overflow-hidden\"\r\n        : \"invisible md:visible md:h-6 animate-fade-out md:animate-none absolute h-0 pb-0 overflow-hidden \"\r\n    }`\r\n  );\r\n\r\n  let contentx;\r\n  if (FavCtx.totalFavs === 0) {\r\n    contentx = <span></span>;\r\n  } else {\r\n    contentx=\r\n    <span className=\" dark:bg-slate-800 bg-white text-indigo-600 dark:text-white rounded-full px-4 ml-2 \">\r\n      {FavCtx.totalFavs}\r\n    </span>;\r\n  }\r\n  return (\r\n    <div className=\"shadow-md  w-full relative top-0 left-0\">\r\n      <div className=\" md:flex items-center justify-between dark:bg-slate-950 bg-white md:py-0 pt-5 pb-4 md:px-0 px-7\">\r\n        <Link to=\"/\">\r\n          <div\r\n            className=\" dark:text-indigo-600 font-bold text-2xl cursor-pointer flex items-center font-urbanist\r\n        text-gray-800 \"\r\n          >\r\n            <span className=\"text-3xl text-indigo-600 mr-1 pt-2\">\r\n              <ion-icon name=\"game-controller-outline\"></ion-icon>\r\n            </span>\r\n            GameHub\r\n          </div>\r\n        </Link>\r\n        <div\r\n          onClick={() => setOpen(!open)}\r\n          className=\"text-3xl text-indigo-600 absolute right-8 top-6 cursor-pointer\r\n         md:hidden \"\r\n        >\r\n          <ion-icon\r\n            name={open ? \"close-circle-outline\" : \"menu-outline\"}\r\n          ></ion-icon>\r\n        </div>\r\n        <div className=\"items-center md:h-20 lg:h-16 md:w-9/12\">\r\n          <ul className={classname}>\r\n            {/* {Links.map((link) => (\r\n              <li\r\n                key={link.name}\r\n                className=\" h-20 md:h-full md:ml-0  text-xl md:py-0 md:my-0 py-0 w-full\"\r\n              >\r\n                <Link\r\n                  to={link.path}\r\n                  className=\" h-full md:h-full text-center  box-border block hover:bg-indigo-300 hover:text-white text-indigo-600 dark:text-gray-500 dark:bg-slate-950 dark:hover:text-indigo-500 dark:hover:bg-slate-950 md:duration-500 md:py-4 pt-7 md:px-4 w-full\"\r\n                >\r\n                  {link.name}\r\n                </Link>\r\n              </li>\r\n            ))} */}\r\n            <li className=\" h-20 md:h-full md:ml-0  text-xl md:py-0 md:my-0 py-0 w-full\">\r\n              <Link\r\n                className=\" h-full md:h-full text-center  box-border block hover:bg-indigo-300 hover:text-white text-indigo-600 dark:text-gray-500 dark:bg-slate-950 dark:hover:text-indigo-500 dark:hover:bg-slate-950 md:duration-500 md:py-4 pt-7 md:px-4 w-full\"\r\n                to=\"/\"\r\n              >\r\n                All Meetups\r\n              </Link>\r\n            </li>\r\n            <li className=\" h-20 md:h-full md:ml-0  text-xl md:py-0 md:my-0 py-0 w-full\">\r\n              <Link\r\n                className=\" h-full md:h-full text-center  box-border block hover:bg-indigo-300 hover:text-white text-indigo-600 dark:text-gray-500 dark:bg-slate-950 dark:hover:text-indigo-500 dark:hover:bg-slate-950 md:duration-500 md:py-4 pt-7 md:px-4 w-full\"\r\n                to=\"/new-meetup\"\r\n              >\r\n                New Meetups\r\n              </Link>\r\n            </li>\r\n            <li className=\" h-20 md:h-full md:ml-0  text-xl md:py-0 md:my-0 py-0 w-full\">\r\n              <Link\r\n                className=\" h-full md:h-full text-center  box-border block hover:bg-indigo-300 hover:text-white text-indigo-600 dark:text-gray-500 dark:bg-slate-950 dark:hover:text-indigo-500 dark:hover:bg-slate-950 md:duration-500 md:py-4 pt-7 md:px-4 w-full\"\r\n                to=\"/favs\"\r\n              >\r\n                My Favourites\r\n                {contentx}\r\n              </Link>\r\n            </li>\r\n            {/* <ThemeSwitcher  /> */}\r\n            <button\r\n              onClick={props.toggleDarkMode}\r\n              className=\" md:h-fit h-full block text-sm text-gray-500 hover:text-black hover:font-bold dark:bg-slate-950 dark:hover:text-indigo-500 dark:hover:bg-slate-950  duration-500 py-7 px-10  md:p-0 w-fit   font-urbanist  md:ml-0\"\r\n            >\r\n              <ion-icon name=\"contrast-outline\"></ion-icon>\r\n            </button>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default MainNav;\r\n","K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\layout\\SButton.js",[],[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\meetups\\MeetupsList.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\meetups\\MeetupItems.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\UI\\Card.js",[],[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\UI\\ToFavs.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\layout\\Layout.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\meetups\\NMForm.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\UI\\ThemeSwitcher.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\pages\\Loading.tsx",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\store\\fav-context.js",[],[],"K:\\Work\\Next Course\\React Refresher\\react-course\\src\\components\\UI\\DefButton.js",[],[],"C:\\Users\\Administrator\\Documents\\GitHub\\GameHub-Demo\\src\\index.js",[],[],"C:\\Users\\Administrator\\Documents\\GitHub\\GameHub-Demo\\src\\App.js",[],[],"C:\\Users\\Administrator\\Documents\\GitHub\\GameHub-Demo\\src\\store\\fav-context.js",[],[],"C:\\Users\\Administrator\\Documents\\GitHub\\GameHub-Demo\\src\\pages\\AllMeetups.js",[],[],"C:\\Users\\Administrator\\Documents\\GitHub\\GameHub-Demo\\src\\pages\\Favs.js",[],[],"C:\\Users\\Administrator\\Documents\\GitHub\\Ga